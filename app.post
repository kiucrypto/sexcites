const express = require('express');
const app = express();
const PORT = process.env.PORT || 10000;

app.use(express.json());
app.use(express.static('public')); // tu carpeta con index.html

// Base de datos temporal de suscripciones
let suscripciones = {};
let contador = 312; // empieza en 312/500

// Pagina principal
app.get('/', (req, res) => {
  res.sendFile(__dirname + '/public/index.html');
});

// VERIFICAR PAGO Y DESBLOQUEAR
app.post('/verificar-pago', (req, res) => {
  const { email, txHash, moneda } = req.body;

  if (!email ||!txHash) {
    return res.json({ ok: false, msg: 'Falta email o hash' });
  }

  // Desbloquea el acceso
  suscripciones[email] = {
    activo: true,
    moneda: moneda,
    tx: txHash,
    fecha: new Date()
  };

  contador++;

  console.log(`💰 PAGO NUEVO: ${email} | ${moneda} | ${txHash}`);

  res.json({
    ok: true,
    msg: 'Pago verificado! Suscripcion activa',
    total: contador
  });
});

// Ver si un email tiene acceso
app.get('/check-acceso/:email', (req, res) => {
  const sub = suscripciones[req.params.email];
  res.json({ acceso: sub? true : false, datos: sub });
});

// Contador para tu pagina
app.get('/api/contador', (req, res) => {
  res.json({ actual: contador, total: 500 });
});

app.listen(PORT, () => {
  console.log(`Servidor corriendo en puerto ${PORT}`);
});
